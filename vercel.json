{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "estimate.thehomeremodelgroup.com" }],
      "destination": "/estimate",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "estimate.thehomeremodelgroup.com" }],
      "destination": "/estimate.html"
    },
    { "source": "/estimate", "destination": "/estimate.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
